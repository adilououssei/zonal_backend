{% extends 'base.html.twig' %}

{% block body %}
<div style="max-width:600px;margin:0 auto;font-family:Arial,sans-serif;padding:20px">
  <div style="text-align:center;padding:30px 0;background:#0B6B3A;border-radius:12px 12px 0 0">
    <img src="{{ absolute_url(asset('images/logo.png')) }}" alt="ZONAL" style="height:50px">
  </div>
  <div style="padding:30px;background:#fff;border:1px solid #e5e7eb;border-top:0;border-radius:0 0 12px 12px">
    <h2 style="color:#111827;margin:0 0 10px">Nouveau message de contact</h2>
    <table style="width:100%;color:#6b7280;font-size:14px;line-height:1.6">
      <tr><td style="padding:4px 0;font-weight:bold;color:#374151">Nom</td><td>{{ name }}</td></tr>
      <tr><td style="padding:4px 0;font-weight:bold;color:#374151">Email</td><td>{{ email }}</td></tr>
      <tr><td style="padding:4px 0;font-weight:bold;color:#374151">Sujet</td><td>{{ subject }}</td></tr>
    </table>
    <hr style="border:none;border-top:1px solid #e5e7eb;margin:20px 0">
    <div style="color:#6b7280;line-height:1.6">{{ message|raw }}</div>
  </div>
</div>
{% endblock %}
