{% extends 'base.html.twig' %}

{% block body %}
<div style="max-width:600px;margin:0 auto;font-family:Arial,sans-serif;padding:20px">
  <div style="text-align:center;padding:30px 0;background:#0B6B3A;border-radius:12px 12px 0 0">
    <img src="{{ absolute_url(asset('images/logoOrigin.png')) }}" alt="ZONAL" style="height:50px">
  </div>
  <div style="padding:0;background:#fff;border:1px solid #e5e7eb;border-top:0;border-radius:0 0 12px 12px;overflow:hidden">
    {% if coverImage %}
      <img src="{{ coverImage }}" alt="" style="width:100%;max-height:220px;object-fit:cover;display:block">
    {% endif %}
    <div style="padding:30px">
      <span style="display:inline-block;background:#0B6B3A1a;color:#0B6B3A;font-size:12px;font-weight:bold;padding:4px 12px;border-radius:999px;margin-bottom:14px">
        {{ contentType }}
      </span>
      <h2 style="color:#111827;margin:0 0 10px">{{ title }}</h2>
      {% if excerpt %}
        <p style="color:#6b7280;line-height:1.6">{{ excerpt }}</p>
      {% endif %}
      <div style="text-align:center;margin:26px 0 10px">
        <a href="{{ contentUrl }}" style="display:inline-block;background:#0B6B3A;color:#fff;padding:14px 32px;border-radius:8px;text-decoration:none;font-weight:bold;font-size:16px">
          Voir sur le site
        </a>
      </div>
      <p style="color:#9ca3af;font-size:12px;margin-top:24px;border-top:1px solid #e5e7eb;padding-top:16px">
        Vous recevez cet email car vous êtes abonné(e) à la newsletter ZONAL{% if name %}, {{ name }}{% endif %}.
        <a href="{{ unsubscribeUrl }}" style="color:#0B6B3A">Se désabonner</a>.
      </p>
    </div>
  </div>
</div>
{% endblock %}
