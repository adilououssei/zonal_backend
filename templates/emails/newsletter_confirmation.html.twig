{% extends 'base.html.twig' %}

{% block body %}
<div style="max-width:600px;margin:0 auto;font-family:Arial,sans-serif;padding:20px">
  <div style="text-align:center;padding:30px 0;background:#0B6B3A;border-radius:12px 12px 0 0">
    <img src="{{ absolute_url(asset('images/logoNoFont2.png')) }}" alt="ZONAL" style="height:50px">
  </div>
  <div style="padding:30px;background:#fff;border:1px solid #e5e7eb;border-top:0;border-radius:0 0 12px 12px">
    <h2 style="color:#111827;margin:0 0 10px">
      {% if name %}
        Merci {{ name }} !
      {% else %}
        Merci de vous être abonné !
      {% endif %}
    </h2>
    <p style="color:#6b7280;line-height:1.6">
      Vous êtes désormais inscrit à notre newsletter. Vous recevrez régulièrement
      nos actualités, événements et actions sur le terrain.
    </p>
    <p style="color:#9ca3af;font-size:12px;margin-top:20px">
      Si vous souhaitez vous désabonner,
      <a href="{{ unsubscribeUrl }}" style="color:#0B6B3A">cliquez ici</a>.
    </p>
  </div>
</div>
{% endblock %}
