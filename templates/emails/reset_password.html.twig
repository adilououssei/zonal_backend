{% extends 'base.html.twig' %}

{% block body %}
<div style="max-width:600px;margin:0 auto;font-family:Arial,sans-serif;padding:20px">
  <div style="text-align:center;padding:30px 0;background:#0B6B3A;border-radius:12px 12px 0 0">
    <img src="{{ absolute_url(asset('images/logo.png')) }}" alt="ZONAL" style="height:50px">
  </div>
  <div style="padding:30px;background:#fff;border:1px solid #e5e7eb;border-top:0;border-radius:0 0 12px 12px">
    <h2 style="color:#111827;margin:0 0 10px">Réinitialisation de mot de passe</h2>
    <p style="color:#6b7280;line-height:1.6">
      Bonjour {{ user.firstName ?? user.email }},<br><br>
      Vous avez demandé la réinitialisation de votre mot de passe.
      Cliquez sur le bouton ci-dessous pour en choisir un nouveau.
      Ce lien expire dans 1 heure.
    </p>
    <div style="text-align:center;margin:30px 0">
      <a href="{{ resetUrl }}" style="display:inline-block;background:#0B6B3A;color:#fff;padding:14px 32px;border-radius:8px;text-decoration:none;font-weight:bold;font-size:16px">
        Réinitialiser mon mot de passe
      </a>
    </div>
    <p style="color:#9ca3af;font-size:12px;margin-top:20px">
      Si vous n'êtes pas à l'origine de cette demande, ignorez cet email.
    </p>
  </div>
</div>
{% endblock %}
